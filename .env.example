# Slack
# For local dev with `slack run`, the Slack CLI injects tokens automatically.
# For Render (HTTP mode), set these manually from api.slack.com/apps:
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Only needed for manual Socket Mode (slack run sets this for you):
# SLACK_APP_TOKEN=xapp-your-app-token

# Tracerfy (https://www.tracerfy.com dashboard)
TRACERFY_API_KEY=your-tracerfy-api-key

# Email results (CSV attachment sent after each job)
RESULTS_EMAIL_TO=niadennis1@outlook.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-sender@gmail.com
SMTP_USE_TLS=true

# Server (Render sets PORT automatically)
PORT=3000
